# Copy to settings.env (gitignored) and edit. Serve it next to the scripts; they load ./settings.env.
SRV=http://192.168.1.10:8765    # Mac/host serving these scripts (and secret/user)
HOST=k3s-pi                      # new hostname
CCDEF=GB                         # Wi-Fi country if the old system doesn't say
TZONE=Europe/London
IMAGE_URL=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-10-06/2026-10-06-raspios-trixie-arm64-lite.img.xz
